# Copy this file to .env and fill in real values. .env is never committed.
# In production, these are set in the Render / Vercel dashboards instead.

# --- Database ---
# Local dev: `docker compose up -d` then use this exact URL (matches docker-compose.yml).
# Production: swap to Neon's connection string, keep connection_limit low.
DATABASE_URL="postgresql://spartacus:spartacus_dev@localhost:5432/spartacus?connection_limit=5&pool_timeout=10"

# --- Discord ---
DISCORD_TOKEN="your-bot-token"
DISCORD_CLIENT_ID="your-application-id"
DISCORD_CLIENT_SECRET="your-application-secret"
# Where Discord sends users after login. Points at the API, not the dashboard.
# Must also be listed under OAuth2 → Redirects in the Discord Developer Portal.
DISCORD_REDIRECT_URI="http://localhost:3001/auth/discord/callback"
# Optional, local dev only: register slash commands to this one server instantly
# instead of globally (global takes up to an hour). Leave blank in production.
DISCORD_DEV_GUILD_ID=""
# Your own Discord user ID. Unlocks owner-only dashboard pages and bot commands.
OWNER_DISCORD_ID=""

# --- Stream Alerts (optional) ---
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# --- AI Chat / AI Moderation (optional) ---
ANTHROPIC_API_KEY=""

# --- Web ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# The dashboard's URL. The API sends users here after login.
NEXTAUTH_URL="http://localhost:3000"
# Where the dashboard finds the API. Use "/api-proxy" together with
# LOCAL_PREVIEW_API below to run the dashboard locally against the live API.
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Optional, local dev only: real API URL that /api-proxy forwards to.
LOCAL_PREVIEW_API=""

# --- Vercel deploy status (optional) ---
# Lets the dashboard show "Updating" while a new dashboard version builds.
# Token: vercel.com → Account Settings → Tokens. Project: its name, e.g. "spartacus".
# Team ID is optional — if unset, every team the token can see is searched.
VERCEL_TOKEN=""
VERCEL_PROJECT=""
VERCEL_TEAM_ID=""

# --- API ---
PORT=3001
# "true" runs the bot inside the API process (how production runs).
# Set "false" to run the bot separately with `npm run dev:bot`.
RUN_BOT_INLINE="true"
