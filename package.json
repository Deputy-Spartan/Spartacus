{
  "name": "spartacus",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:bot": "npm run dev --workspace=apps/bot",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "start": "npm run db:deploy && npm run start --workspace=apps/api",
    "start:web": "npm run start --workspace=apps/web",
    "deploy-commands": "npm run deploy-commands --workspace=apps/bot",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:deploy": "npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma && npx prisma generate --schema=packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
