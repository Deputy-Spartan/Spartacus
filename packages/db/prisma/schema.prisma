datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Guild {
  id                String               @id // Discord guild ID
  name              String?
  modules           ModuleToggle[]
  welcomeConfig     WelcomeConfig?
  customCommands    CustomCommand[]
  events            Event[]
  streamSubs        StreamSubscription[]
  members           MemberXp[]
  loggingConfig     LoggingConfig?
  antiRaidConfig    AntiRaidConfig?
  reactionRoles     ReactionRole[]
  joinRoles         JoinRole[]
  stickyMessages    StickyMessage[]
  starboardConfig   StarboardConfig?
  starredMessages   StarredMessage[]
  tempChannelLobbies TempChannelLobby[]
  tempChannelInstances TempChannelInstance[]
  ticketPanels      TicketPanel[]
  tickets           Ticket[]
  ticketTypes       TicketType[]
  ticketTags        TicketTag[]
  ticketCannedResponses TicketCannedResponse[]
  ticketKnowledgeBases TicketKnowledgeBase[]
  ticketSettings    TicketSettings?
  giveaways         Giveaway[]
  moderationCases   ModerationCase[]
  verificationConfig VerificationConfig?
  quarantineRecords QuarantineRecord[]
  antiNukeConfig    AntiNukeConfig?
  honeypotConfig    HoneypotConfig?
  roleSnapshots     RoleSnapshot[]
  scheduledMessages ScheduledMessage[]
  polls             Poll[]
  suggestions       Suggestion[]
  economyConfig     EconomyConfig?
  economyBalances   EconomyBalance[]
  economyTransactions EconomyTransaction[]
  levelRoles        LevelRole[]
  xpBlacklist       XpBlacklistEntry[]
  countingGameConfig CountingGameConfig?
  invites           InviteStat[]
  modmailThreads    ModmailThread[]
  serverPartnerships ServerPartnership[]
  playerReports     PlayerReport[]
  permWatchConfig   PermWatchConfig?
  channelLocks      ChannelLock[]
  commandToggles    CommandToggle[]
  customSlashCommands CustomSlashCommand[]
  statChannels      StatChannel[]
  statusChannels    StatusChannel[]
  aiConfig          AiConfig?
  serverBackups     ServerBackup[]
  buttonPresets     ButtonPreset[]
  savedEmbeds       SavedEmbed[]
  eventTemplates    EventTemplate[]
  eventSettings     EventSettings?
  dashboardAuditEntries DashboardAuditEntry[]
  rolePanels        RolePanel[]
  announcements     Announcement[]
  autoPurgeConfigs  AutoPurgeConfig[]
  birthdayConfig    BirthdayConfig?
  birthdays         Birthday[]
  applicationPanels ApplicationPanel[]
  applicationTypes  ApplicationType[]
  applications      Application[]
  applicationSettings ApplicationSettings?
  createdAt         DateTime             @default(now())
}

enum ModuleKey {
  MODERATION
  WELCOME
  LEVELING
  STREAM_ALERTS
  CUSTOM_COMMANDS
  EVENTS
  LOGGING
  ANTI_RAID
  REACTION_ROLES
  JOIN_ROLES
  STICKY_MESSAGES
  STARBOARD
  TEMP_CHANNELS
  TICKETS
  GIVEAWAYS
  VERIFICATION
  QUARANTINE
  ANTI_NUKE
  HONEYPOT
  ROLE_PERSISTENCE
  SCHEDULED_MESSAGES
  POLLS
  SUGGESTIONS
  ECONOMY
  COUNTING_GAME
  TRIVIA
  CASINO
  INVITE_TRACKING
  MODMAIL
  PLAYER_REPORTS
  PERM_WATCH
  CHANNEL_LOCKS
  STAT_CHANNELS
  AI_CHAT
  AI_MODERATION
  SERVER_BACKUP
  ROLE_PANELS
  ANNOUNCEMENTS
  SLOW_MODE
  BIRTHDAYS
  APPLICATIONS
  STATUS_CHANNEL
}

model ModuleToggle {
  id      String    @id @default(cuid())
  guild   Guild     @relation(fields: [guildId], references: [id])
  guildId String
  key     ModuleKey
  enabled Boolean   @default(false)
  config  Json?

  @@unique([guildId, key])
  @@index([guildId])
}

model WelcomeConfig {
  id           String  @id @default(cuid())
  guild        Guild   @relation(fields: [guildId], references: [id])
  guildId      String  @unique
  channelId    String?
  welcomeText  String?
  goodbyeText  String?
  embedColor   String? @default("#00E5FF")
  embedEnabled Boolean @default(true)
  embedTitle   String?
  buttons      Json    @default("[]")
}

model CustomCommand {
  id           String   @id @default(cuid())
  guild        Guild    @relation(fields: [guildId], references: [id])
  guildId      String
  trigger      String
  response     String
  embedEnabled Boolean  @default(false)
  embedTitle   String?
  embedColor   String?
  buttons      Json     @default("[]")
  createdAt    DateTime @default(now())

  @@unique([guildId, trigger])
}

model StreamSubscription {
  id                String    @id @default(cuid())
  guild             Guild     @relation(fields: [guildId], references: [id])
  guildId           String
  platform          String // "twitch" | "youtube"
  channelName       String
  announceChannelId String
  isLive            Boolean   @default(false)
  lastNotifiedAt    DateTime?

  @@index([guildId])
}

model MemberXp {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  userId    String
  xp        Int      @default(0)
  level     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp])
}

// ---- Raid Helper / Event Coordination ----

enum EventStatus {
  SCHEDULED
  REMINDED
  COMPLETED
  CANCELLED
}

model Event {
  id                    String        @id @default(cuid())
  guild                 Guild         @relation(fields: [guildId], references: [id])
  guildId               String
  title                 String
  description           String?
  channelId             String
  messageId             String?
  createdById           String
  startTime             DateTime
  status                EventStatus   @default(SCHEDULED)
  reminderMinutesBefore Int           @default(15)
  embedEnabled          Boolean       @default(true)
  embedColor            String?       @default("#00E5FF")
  buttons               Json          @default("[]")
  // Which RSVP role buttons show on the event (and correspondingly which
  // stat fields the embed shows) — e.g. a simple meetup might only want
  // Attending/Absent, not the raid roles.
  enabledRoles          Json          @default("[\"TANK\",\"DPS\",\"HEALER\",\"ATTENDING\",\"ABSENT\"]")
  needsSync             Boolean       @default(true) // true = bot must (re)post/edit the Discord message
  discordEventId        String? // native Discord "Scheduled Event" (Events tab) mirroring this — separate from messageId's RSVP embed
  signups               EventSignup[]
  createdAt             DateTime      @default(now())

  @@index([guildId, startTime])
}

enum SignupRole {
  TANK
  DPS
  HEALER
  ATTENDING
  ABSENT
  TENTATIVE
}

model EventSignup {
  id         String     @id @default(cuid())
  event      Event      @relation(fields: [eventId], references: [id])
  eventId    String
  userId     String
  role       SignupRole
  reminded   Boolean    @default(false)
  signedUpAt DateTime   @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}

model ButtonPreset {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  name      String
  buttons   Json     @default("[]")
  createdAt DateTime @default(now())

  @@unique([guildId, name])
}

model SavedEmbed {
  id               String   @id @default(cuid())
  guild            Guild    @relation(fields: [guildId], references: [id])
  guildId          String
  name             String
  content          String?
  embedEnabled     Boolean  @default(true)
  embedTitle       String?
  embedDescription String?
  embedColor       String?  @default("#00E5FF")
  buttons          Json     @default("[]")
  createdAt        DateTime @default(now())

  @@unique([guildId, name])
}

model EventTemplate {
  id                    String   @id @default(cuid())
  guild                 Guild    @relation(fields: [guildId], references: [id])
  guildId               String
  name                  String
  title                 String
  description           String?
  reminderMinutesBefore Int      @default(15)
  embedEnabled          Boolean  @default(true)
  embedColor            String?  @default("#00E5FF")
  buttons               Json     @default("[]")
  enabledRoles          Json     @default("[\"TANK\",\"DPS\",\"HEALER\",\"ATTENDING\",\"ABSENT\"]")
  createdAt             DateTime @default(now())

  @@unique([guildId, name])
}

model EventSettings {
  id                String  @id @default(cuid())
  guild             Guild   @relation(fields: [guildId], references: [id])
  guildId           String  @unique
  defaultChannelId  String?
  defaultReminder   Int     @default(15)
  mentionRoleId     String?
}

// ---- Logging ----

model LoggingConfig {
  id             String   @id @default(cuid())
  guild          Guild    @relation(fields: [guildId], references: [id])
  guildId        String   @unique
  logChannelId   String?

  // Moderation Events
  logMemberMuted    Boolean @default(true)
  logMemberUnmuted  Boolean @default(true)
  logModerationBan  Boolean @default(true)
  logModerationUnban Boolean @default(true)

  // Message Events
  logEdits        Boolean @default(true)
  logDeletes      Boolean @default(true)
  logInvitePosted Boolean @default(false)

  // Member Events
  logNicknameChanged Boolean @default(false)
  logMemberBanned    Boolean @default(true)
  logJoinsLeaves     Boolean @default(true) // covers both member joined + left
  logMemberUnbanned  Boolean @default(true)
  logUserUpdated     Boolean @default(false)

  // Role Events
  logRoleCreated       Boolean @default(false)
  logRoleUpdated       Boolean @default(false)
  logRoleDeleted       Boolean @default(false)
  logMemberRolesChanged Boolean @default(false)

  // Voice Events
  logVoice Boolean @default(false) // covers join + leave + move

  // Server Events
  logServerEdited  Boolean @default(false)
  logEmojisUpdated Boolean @default(false)

  // Channel Events
  logChannelCreated Boolean @default(false)
  logChannelUpdated Boolean @default(false)
  logChannelDeleted Boolean @default(false)

  // Ignored / Additional settings
  ignoredChannelIds Json    @default("[]")
  ignoreBots        Boolean @default(true)
  hideThumbnails    Boolean @default(false)
}

// ---- Anti-Raid ----

model AntiRaidConfig {
  id                String  @id @default(cuid())
  guild             Guild   @relation(fields: [guildId], references: [id])
  guildId           String  @unique
  alertChannelId    String?
  joinRateLimit     Int     @default(10) // members
  joinRateWindowSec Int     @default(30)
  minAccountAgeDays Int     @default(3)
  autoLockdown      Boolean @default(false)
}

// ---- Reaction Roles ----

model ReactionRole {
  id        String @id @default(cuid())
  guild     Guild  @relation(fields: [guildId], references: [id])
  guildId   String
  channelId String
  messageId String
  emoji     String
  roleId    String

  @@unique([messageId, emoji])
  @@index([guildId])
}

// ---- Join Roles ----

model JoinRole {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  roleId  String

  @@unique([guildId, roleId])
}

// ---- Sticky Messages ----

model StickyMessage {
  id               String  @id @default(cuid())
  guild            Guild   @relation(fields: [guildId], references: [id])
  guildId          String
  channelId        String  @unique
  content          String
  lastMessageId    String?
  embedEnabled     Boolean @default(false)
  embedTitle       String?
  embedDescription String?
  embedColor       String? // hex, e.g. "#5865F2"
  // Link buttons only (label + url) — no custom_id, so no interaction
  // handler is needed on the bot side. [{ "label": string, "url": string }]
  buttons          Json    @default("[]")
}

// ---- Starboard ----

model StarboardConfig {
  id          String @id @default(cuid())
  guild       Guild  @relation(fields: [guildId], references: [id])
  guildId     String @unique
  channelId   String?
  threshold   Int    @default(5)
}

model StarredMessage {
  id                String @id @default(cuid())
  guild             Guild  @relation(fields: [guildId], references: [id])
  guildId           String
  originalMessageId String
  starboardMessageId String?
  starCount         Int    @default(0)

  @@unique([guildId, originalMessageId])
}

// ---- Temp Channels ----

model TempChannelLobby {
  id               String  @id @default(cuid())
  guild            Guild   @relation(fields: [guildId], references: [id])
  guildId          String
  name             String
  lobbyChannelId   String
  categoryId       String?
  nameFormat       String  @default("Channel")
  userLimit        Int     @default(0)
  bitrate          Int     @default(64000)
  deleteAfterEmptySec Int  @default(0)
  pairTextChannel  Boolean @default(false)
  hideTextFromNonMembers Boolean @default(true)

  @@index([guildId])
}

model TempChannelInstance {
  id         String   @id @default(cuid())
  guild      Guild    @relation(fields: [guildId], references: [id])
  guildId    String
  lobbyId    String
  channelId  String
  textChannelId String?
  ownerId    String
  createdAt  DateTime @default(now())

  @@index([guildId])
}

// ---- Tickets ----

enum TicketPanelLayout {
  BUTTONS
  DROPDOWN
}

model TicketPanel {
  id            String            @id @default(cuid())
  guild         Guild             @relation(fields: [guildId], references: [id])
  guildId       String
  name          String
  channelId     String
  layout        TicketPanelLayout @default(BUTTONS)
  typeIds       Json              @default("[]") // ordered TicketType ids offered on this panel
  description   String?
  paused        Boolean           @default(false)
  messageId     String?
  ticketCounter Int               @default(0) // per-panel sequential ticket numbering

  // Legacy single-type fields, kept for panels created before ticket types existed.
  categoryId    String?
  buttonLabel   String            @default("Open a Ticket")
  supportRoleId String?

  @@index([guildId])
}

model TicketType {
  id             String   @id @default(cuid())
  guild          Guild    @relation(fields: [guildId], references: [id])
  guildId        String
  name           String
  emoji          String?
  description    String?
  categoryId     String?
  staffRoleIds   Json     @default("[]")
  openMessage    String?
  modalFields    Json     @default("[]") // [{ label, placeholder, required, style }]
  autoCloseHours Int?
  slaMinutes     Int?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([guildId])
}

enum TicketStatus {
  OPEN
  CLAIMED
  CLOSED
}

model Ticket {
  id           String       @id @default(cuid())
  guild        Guild        @relation(fields: [guildId], references: [id])
  guildId      String
  panelId      String
  typeId       String?
  ticketNumber Int
  channelId    String
  userId       String
  claimedById  String?
  status       TicketStatus @default(OPEN)
  priority     String?
  tags         Json         @default("[]")
  closeReason  String?
  transcriptUrl String?
  feedbackRating Int?
  createdAt    DateTime     @default(now())
  closedAt     DateTime?

  @@index([guildId, status])
}

model TicketTag {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  name    String
  color   String @default("#5865F2")

  @@index([guildId])
}

model TicketCannedResponse {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  title   String
  content String

  @@index([guildId])
}

model TicketKnowledgeBase {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  name    String
  content String

  @@index([guildId])
}

model TicketSettings {
  id                  String  @id @default(cuid())
  guild               Guild   @relation(fields: [guildId], references: [id])
  guildId             String  @unique
  logChannelId        String?
  transcriptChannelId String?
  channelNameFormat   String  @default("ticket-{user}")
  ticketCap           Int     @default(0)
  requireCloseReason  Boolean @default(false)
  supportRoleIds      Json    @default("[]")
  blacklistUserIds    Json    @default("[]")
  blacklistRoleIds    Json    @default("[]")
}

// ---- Giveaways ----

model Giveaway {
  id          String   @id @default(cuid())
  guild       Guild    @relation(fields: [guildId], references: [id])
  guildId     String
  channelId   String
  messageId   String?
  prize       String
  description String?
  embedColor  String?  @default("#B14BFF")
  imageUrl    String?
  buttons     Json     @default("[]")
  winnerCount Int      @default(1)
  endsAt      DateTime
  ended       Boolean  @default(false)
  entries     GiveawayEntry[]

  @@index([guildId, endsAt])
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id])
  giveawayId String
  userId     String

  @@unique([giveawayId, userId])
}

// ---- Moderation Cases (persistent history behind /kick /ban /mute /warn) ----

enum CaseAction {
  WARN
  MUTE
  KICK
  BAN
  UNBAN
  UNMUTE
}

model ModerationCase {
  id          String     @id @default(cuid())
  guild       Guild      @relation(fields: [guildId], references: [id])
  guildId     String
  caseNumber  Int
  userId      String
  action      CaseAction
  reason      String?
  moderatorId String
  createdAt   DateTime   @default(now())

  @@unique([guildId, caseNumber])
  @@index([guildId, userId])
}

// ---- Verification ----

model VerificationConfig {
  id             String  @id @default(cuid())
  guild          Guild   @relation(fields: [guildId], references: [id])
  guildId        String  @unique
  verifiedRoleId String?
  minAccountAgeDays Int  @default(0)
}

// ---- Quarantine ----

model QuarantineRecord {
  id            String   @id @default(cuid())
  guild         Guild    @relation(fields: [guildId], references: [id])
  guildId       String
  userId        String
  reason        String?
  quarantinedBy String
  previousRoles String[] // role IDs to restore on release
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([guildId, active])
}

// ---- Anti-Nuke ----

model AntiNukeConfig {
  id                String  @id @default(cuid())
  guild             Guild   @relation(fields: [guildId], references: [id])
  guildId           String  @unique
  alertChannelId    String?
  maxBansPerMinute  Int     @default(3)
  maxChannelDeletesPerMinute Int @default(3)
  stripRolesOnTrigger Boolean @default(true)
}

// ---- Honeypot ----

model HoneypotConfig {
  id        String  @id @default(cuid())
  guild     Guild   @relation(fields: [guildId], references: [id])
  guildId   String  @unique
  channelId String?
}

// ---- Role Persistence ----

model RoleSnapshot {
  id      String   @id @default(cuid())
  guild   Guild    @relation(fields: [guildId], references: [id])
  guildId String
  userId  String
  roleIds String[]
  savedAt DateTime @default(now())

  @@unique([guildId, userId])
}

// ---- Scheduled Messages ----

model ScheduledMessage {
  id            String    @id @default(cuid())
  guild         Guild     @relation(fields: [guildId], references: [id])
  guildId       String
  channelId     String
  content       String
  cronExpr      String // e.g. "0 9 * * 1" (every Monday 9am)
  lastSentAt    DateTime?

  @@index([guildId])
}

// ---- Polls ----

model Poll {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  channelId String
  messageId String?
  question  String
  options   String[] // display labels, indexed by position
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())
  votes     PollVote[]

  @@index([guildId])
}

model PollVote {
  id       String @id @default(cuid())
  poll     Poll   @relation(fields: [pollId], references: [id])
  pollId   String
  userId   String
  option   Int

  @@unique([pollId, userId])
}

// ---- Suggestions ----

enum SuggestionStatus {
  PENDING
  APPROVED
  DENIED
}

model Suggestion {
  id        String           @id @default(cuid())
  guild     Guild            @relation(fields: [guildId], references: [id])
  guildId   String
  channelId String
  messageId String?
  userId    String
  content   String
  status    SuggestionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([guildId, status])
}

// ---- Economy ----

model EconomyConfig {
  id           String  @id @default(cuid())
  guild        Guild   @relation(fields: [guildId], references: [id])
  guildId      String  @unique
  currencyName String  @default("Coins")
  currencyIcon String  @default("🪙")
  embedColor   String  @default("#E8C547")
  maxBalance   Int     @default(1000000000)

  earnOnMessages    Boolean @default(true)
  messageEarnMin    Int     @default(2)
  messageEarnMax    Int     @default(6)
  messageCooldownSec Int    @default(60)
  minMessageLength  Int     @default(4)

  dailyEnabled   Boolean @default(true)
  dailyAmount    Int     @default(200)
  streakBonusPerDay Int  @default(0)
  streakCapDays  Int     @default(7)

  transfersEnabled   Boolean @default(true)
  transferMinAmount  Int     @default(1)
  transferTaxPercent Int     @default(0)

  channelMultipliers Json @default("[]") // [{ channelId, multiplier }]
  roleMultipliers    Json @default("[]") // [{ roleId, multiplier }]

  maxBet       Int     @default(5000)
}

model EconomyBalance {
  id             String    @id @default(cuid())
  guild          Guild     @relation(fields: [guildId], references: [id])
  guildId        String
  userId         String
  balance        Int       @default(0)
  totalEarned    Int       @default(0)
  totalSpent     Int       @default(0)
  dailyStreak    Int       @default(0)
  lastDailyClaim DateTime?
  lastMessageEarnAt DateTime?

  @@unique([guildId, userId])
  @@index([guildId, balance])
}

model EconomyTransaction {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  userId    String
  amount    Int // positive = earned, negative = removed/spent
  reason    String // "message" | "daily" | "transfer_in" | "transfer_out" | "transfer_tax" | "casino" | "admin"
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

// ---- Level Roles / XP Blacklist ----

model LevelRole {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  level   Int
  roleId  String

  @@unique([guildId, level])
}

enum XpBlacklistType {
  CHANNEL
  ROLE
}

model XpBlacklistEntry {
  id       String          @id @default(cuid())
  guild    Guild           @relation(fields: [guildId], references: [id])
  guildId  String
  targetId String
  type     XpBlacklistType

  @@unique([guildId, targetId])
}

// ---- Counting Game ----

model CountingGameConfig {
  id             String  @id @default(cuid())
  guild          Guild   @relation(fields: [guildId], references: [id])
  guildId        String  @unique
  channelId      String?
  currentCount   Int     @default(0)
  lastUserId     String?
  resetOnMistake Boolean @default(true)
  highScore      Int     @default(0)
}

// ---- Invite Tracking ----

model InviteStat {
  id        String @id @default(cuid())
  guild     Guild  @relation(fields: [guildId], references: [id])
  guildId   String
  inviterId String
  uses      Int    @default(0)

  @@unique([guildId, inviterId])
}

// ---- Modmail ----

model ModmailThread {
  id         String   @id @default(cuid())
  guild      Guild    @relation(fields: [guildId], references: [id])
  guildId    String
  userId     String
  channelId  String // staff-side thread channel
  subject    String?
  open       Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([guildId, open])
}

// ---- Server Partnerships ----

model ServerPartnership {
  id            String   @id @default(cuid())
  guild         Guild    @relation(fields: [guildId], references: [id])
  guildId       String
  partnerName   String
  partnerInvite String?
  type          String // "Ad Exchange" | "Full Alliance" etc
  since         DateTime @default(now())
}

// ---- Player Reports ----

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
}

model PlayerReport {
  id             String       @id @default(cuid())
  guild          Guild        @relation(fields: [guildId], references: [id])
  guildId        String
  reporterId     String
  reportedUserId String
  reason         String
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  @@index([guildId, status])
}

// ---- Perm Watch ----

model PermWatchConfig {
  id             String  @id @default(cuid())
  guild          Guild   @relation(fields: [guildId], references: [id])
  guildId        String  @unique
  alertChannelId String?
}

// ---- Channel Locks ----

model ChannelLock {
  id                String   @id @default(cuid())
  guild             Guild    @relation(fields: [guildId], references: [id])
  guildId           String
  channelId         String   @unique
  allowImages       Boolean  @default(true)
  allowLinks        Boolean  @default(true)
  allowFiles        Boolean  @default(true)
  allowMessages     Boolean  @default(true) // if false, only images/links/files/commands per the other toggles are allowed through
  slashCommandsOnly Boolean  @default(false) // deletes every regular message, only slash command usage is untouched
  // Messages must start with one of these to survive (in addition to
  // whatever the other toggles already allow) — empty means no requirement.
  requiredPrefixes  Json     @default("[]")
  bannedWords       Json     @default("[]")

  // Deletion notice — posted in-channel and/or DMed to the author when their
  // message gets removed for violating this lock.
  notifyEnabled      Boolean  @default(false)
  notifyContent      String?  @default("{user}, that message isn't allowed in {channel}.")
  notifyEmbedEnabled Boolean  @default(false)
  notifyEmbedTitle   String?
  notifyEmbedColor   String?  @default("#00E5FF")
  notifyButtons      Json     @default("[]")
  notifyDeleteAfterSec Int    @default(6) // 0 disables auto-delete of the in-channel notice
  dmUser             Boolean  @default(false)

  createdAt         DateTime @default(now())
}

// ---- Error Log ----
// Deliberately not a relation to Guild — an error can happen before a
// guild row exists (that's sometimes exactly the bug being logged), or
// entirely outside any guild context (auth failures, startup errors).

model ErrorLog {
  id        String   @id @default(cuid())
  guildId   String?
  source    String // "api" | "bot"
  message   String
  stack     String?
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

// ---- Bot Customization ----
// Account-wide, not per-guild — a bot's username/avatar/presence/
// description are Discord application-level settings, the same across
// every server it's in. Always exactly one row (id "singleton").

model BotConfig {
  id              String    @id @default("singleton")
  username        String?
  description     String?
  statusType      String    @default("online") // online | idle | dnd | invisible
  activityType    String    @default("PLAYING") // PLAYING | WATCHING | LISTENING | COMPETING | CUSTOM
  activityText    String?
  lastHeartbeatAt DateTime? // written every ~20s by the running bot process; the dashboard/status channel treat this as stale (offline) after ~60s
  updatedAt       DateTime  @updatedAt
}

// ---- Server Stat Channels ----
// Voice channels renamed periodically to show a live count (member count,
// boost count, etc) — Discord caps channel renames at ~2/10min per
// channel, so the bot job updates these on a slow interval, not live.

model StatChannel {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  channelId String   @unique
  statType  String // MEMBER_COUNT | BOOST_COUNT | CHANNEL_COUNT
  format    String   @default("{stat}: {count}")
  createdAt DateTime @default(now())
}

// ---- Status Channel (Utility) ----
// A live embed posted to a chosen text channel showing whether the bot is
// currently online, edited in place on a short interval (reuses
// BotConfig.lastHeartbeatAt as the source of truth).

model StatusChannel {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  channelId String   @unique
  messageId String?
  createdAt DateTime @default(now())
}

// ---- AI Chat + Moderation ----
// One config row per guild — AI_CHAT and AI_MODERATION are gated by the
// normal module toggle system, this just holds the extra settings each
// needs. Requires ANTHROPIC_API_KEY to be set on the bot process; if it
// isn't, both features log an error and no-op rather than crash anything.

model AiConfig {
  id                String  @id @default(cuid())
  guild             Guild   @relation(fields: [guildId], references: [id])
  guildId           String  @unique
  chatChannelId     String? // null = respond anywhere the bot is @-mentioned
  chatSystemPrompt  String?
  moderationEnabled Boolean @default(false)
}

// ---- Server Backup ----

model ServerBackup {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  name      String
  data      Json // snapshot of roles + channels at backup time
  createdAt DateTime @default(now())
}

// ---- Per-Command Toggles ----
// Independent of the module toggle system — a whole module can stay on
// while one specific slash command inside it is switched off. Only rows
// for explicitly-disabled commands are stored; anything with no row here
// is enabled by default.

model CommandToggle {
  id          String  @id @default(cuid())
  guild       Guild   @relation(fields: [guildId], references: [id])
  guildId     String
  commandName String
  enabled     Boolean @default(true)

  @@unique([guildId, commandName])
}

// ---- Custom Slash Command Builder ----
// User-created, per-guild slash commands — registered live as real Discord
// guild commands (not the built-in static ones), each running one preset
// action. discordCommandId is what Discord assigns on registration, needed
// to update/delete the live command later.

model CustomSlashCommand {
  id               String  @id @default(cuid())
  guild            Guild   @relation(fields: [guildId], references: [id])
  guildId          String
  name             String
  description      String
  discordCommandId String?
  actionType       String // SEND_MESSAGE | GIVE_ROLE | REMOVE_ROLE | ADD_CURRENCY | POST_EMBED
  ephemeralReply   Boolean @default(true)
  messageText      String? // SEND_MESSAGE
  roleId           String? // GIVE_ROLE / REMOVE_ROLE
  currencyAmount   Int? // ADD_CURRENCY
  embedEnabled     Boolean @default(false) // POST_EMBED
  embedTitle       String?
  embedDescription String?
  embedColor       String?
  buttons          Json    @default("[]")
  createdAt        DateTime @default(now())

  @@unique([guildId, name])
}

// ---- Role Panels ----
// Button/dropdown self-assignable roles — a more modern alternative to
// reaction roles, following the same panel pattern as tickets.

enum RolePanelLayout {
  BUTTONS
  DROPDOWN
}

model RolePanel {
  id          String          @id @default(cuid())
  guild       Guild           @relation(fields: [guildId], references: [id])
  guildId     String
  name        String
  channelId   String
  description String?
  layout      RolePanelLayout @default(BUTTONS)
  options     Json            @default("[]") // [{ roleId, label, emoji }]
  messageId   String?

  @@index([guildId])
}

// ---- Announcements ----

model Announcement {
  id           String    @id @default(cuid())
  guild        Guild     @relation(fields: [guildId], references: [id])
  guildId      String
  channelId    String
  content      String?
  embedEnabled Boolean   @default(false)
  embedTitle   String?
  embedColor   String?   @default("#00E5FF")
  buttons      Json      @default("[]")
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([guildId, sentAt])
}

// ---- Auto Purge (Moderator → Auto Purge tab) ----

model AutoPurgeConfig {
  id              String    @id @default(cuid())
  guild           Guild     @relation(fields: [guildId], references: [id])
  guildId         String
  channelId       String    @unique
  intervalMinutes Int       @default(60)
  ignorePinned    Boolean   @default(true)
  ignoreImages    Boolean   @default(false)
  ignoreLinks     Boolean   @default(false)
  protectedEmojis Json      @default("[]") // messages carrying any of these reactions are skipped
  lastRunAt       DateTime?

  @@index([guildId])
}

// ---- Birthdays ----

model BirthdayConfig {
  id              String  @id @default(cuid())
  guild           Guild   @relation(fields: [guildId], references: [id])
  guildId         String  @unique
  channelId       String?
  embedTitle      String? @default("🎂 Happy Birthday!")
  embedMessage    String? @default("Everyone wish {user} a happy birthday! 🎉")
  embedColor      String? @default("#FF69B4")
  pingRoleId      String?
  useButton       Boolean @default(false) // post a "Set My Birthday" button panel instead of relying on /birthday set alone
  buttonChannelId String?
  buttonMessageId String?
}

model Birthday {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  userId  String
  month   Int
  day     Int

  @@unique([guildId, userId])
  @@index([guildId, month, day])
}

// ---- Applications ----

enum ApplicationPanelLayout {
  BUTTONS
  DROPDOWN
}

model ApplicationPanel {
  id          String                 @id @default(cuid())
  guild       Guild                  @relation(fields: [guildId], references: [id])
  guildId     String
  name        String
  channelId   String
  description String?
  layout      ApplicationPanelLayout @default(BUTTONS)
  typeIds     Json                   @default("[]") // ordered ApplicationType ids offered on this panel
  messageId   String?
  paused      Boolean                @default(false)

  @@index([guildId])
}

model ApplicationType {
  id              String   @id @default(cuid())
  guild           Guild    @relation(fields: [guildId], references: [id])
  guildId         String
  name            String
  emoji           String?
  description     String?
  reviewChannelId String?
  staffRoleIds    Json     @default("[]")
  questions       Json     @default("[]") // [{ label, style: "SHORT"|"PARAGRAPH", required }] — max 5 (Discord modal limit)
  acceptMessage   String?  @default("🎉 Your application for {type} was accepted!")
  denyMessage     String?  @default("Your application for {type} was not accepted this time.")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([guildId])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  DENIED
}

model Application {
  id              String            @id @default(cuid())
  guild           Guild             @relation(fields: [guildId], references: [id])
  guildId         String
  panelId         String
  typeId          String?
  userId          String
  answers         Json              @default("[]") // [{ label, answer }]
  status          ApplicationStatus @default(PENDING)
  reviewedBy      String?
  reviewMessageId String?
  createdAt       DateTime          @default(now())

  @@index([guildId, status])
}

model ApplicationSettings {
  id             String  @id @default(cuid())
  guild          Guild   @relation(fields: [guildId], references: [id])
  guildId        String  @unique
  logChannelId   String?
  supportRoleIds Json    @default("[]")
}

// ---- Dashboard Activity ----

model DashboardAuditEntry {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  userId    String
  username  String
  method    String
  path      String
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}
