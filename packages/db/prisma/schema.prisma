datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Guild {
  id                String               @id // Discord guild ID
  name              String?
  // A text channel the bot creates on first upload to host images the
  // dashboard's "upload an image" controls send — Discord's CDN needs a
  // real message to attach a file to, so this is where those messages live.
  assetChannelId    String?
  modules           ModuleToggle[]
  welcomeConfig     WelcomeConfig?
  customCommands    CustomCommand[]
  events            Event[]
  streamSubs        StreamSubscription[]
  members           MemberXp[]
  loggingConfig     LoggingConfig?
  antiRaidConfig    AntiRaidConfig?
  reactionRoles     ReactionRole[]
  reactionRolePanels ReactionRolePanel[]
  joinRoles         JoinRole[]
  stickyMessages    StickyMessage[]
  starboardConfig   StarboardConfig?
  starredMessages   StarredMessage[]
  tempChannelLobbies TempChannelLobby[]
  tempChannelInstances TempChannelInstance[]
  ticketPanels      TicketPanel[]
  tickets           Ticket[]
  ticketTypes       TicketType[]
  ticketTags        TicketTag[]
  ticketCannedResponses TicketCannedResponse[]
  ticketKnowledgeBases TicketKnowledgeBase[]
  ticketSettings    TicketSettings?
  giveaways         Giveaway[]
  moderationCases   ModerationCase[]
  verificationConfig VerificationConfig?
  quarantineRecords QuarantineRecord[]
  antiNukeConfig    AntiNukeConfig?
  honeypotConfig    HoneypotConfig?
  roleSnapshots     RoleSnapshot[]
  scheduledMessages ScheduledMessage[]
  polls             Poll[]
  suggestions       Suggestion[]
  economyConfig     EconomyConfig?
  economyBalances   EconomyBalance[]
  economyTransactions EconomyTransaction[]
  levelRoles        LevelRole[]
  levelingSettings  LevelingSettings?
  xpBlacklist       XpBlacklistEntry[]
  countingGameConfig CountingGameConfig?
  invites           InviteStat[]
  modmailThreads    ModmailThread[]
  serverPartnerships ServerPartnership[]
  playerReports     PlayerReport[]
  permWatchConfig   PermWatchConfig?
  channelLocks      ChannelLock[]
  commandToggles    CommandToggle[]
  customSlashCommands CustomSlashCommand[]
  statChannels      StatChannel[]
  statusChannels    StatusChannel[]
  alertSettings     AlertSettings?
  warnEscalationSettings WarnEscalationSettings?
  appealSettings    AppealSettings?
  appeals           Appeal[]
  modDigestSettings ModDigestSettings?
  voiceSessions     VoiceSession[]
  voiceActivity     VoiceActivity[]
  weeklyRecapSettings WeeklyRecapSettings?
  achievements      Achievement[]
  achievementSettings AchievementSettings?
  customAchievements CustomAchievement[]
  aiConfig          AiConfig?
  serverBackups     ServerBackup[]
  buttonPresets     ButtonPreset[]
  savedEmbeds       SavedEmbed[]
  eventTemplates    EventTemplate[]
  eventSettings     EventSettings?
  dashboardAuditEntries DashboardAuditEntry[]
  pinnedModules     PinnedModule[]
  rolePanels        RolePanel[]
  announcements     Announcement[]
  autoPurgeConfigs  AutoPurgeConfig[]
  birthdayConfig    BirthdayConfig?
  birthdays         Birthday[]
  applicationPanels ApplicationPanel[]
  applicationTypes  ApplicationType[]
  applications      Application[]
  applicationDrafts ApplicationDraft[]
  applicationSettings ApplicationSettings?
  growthSnapshots   GrowthSnapshot[]
  bumpReminderSettings BumpReminderSettings?
  confessionSettings ConfessionSettings?
  milestoneSettings MilestoneSettings?
  rulesGateSettings RulesGateSettings?
  prestigeSettings  PrestigeSettings?
  suggestionAnalyticsSettings SuggestionAnalyticsSettings?
  lfgCommands       LfgCommand[]
  embedCreatorPresets EmbedCreatorPreset[]
  embedComponentActions EmbedComponentAction[]
  supportFlows      SupportFlow[]
  supportTickets    SupportTicket[]
  supportSettings   SupportSettings?
  welcomeGreetings  WelcomeGreeting[]
  createdAt         DateTime             @default(now())
}

enum ModuleKey {
  MODERATION
  WELCOME
  LEVELING
  STREAM_ALERTS
  CUSTOM_COMMANDS
  EVENTS
  LOGGING
  ANTI_RAID
  REACTION_ROLES
  STICKY_MESSAGES
  STARBOARD
  TEMP_CHANNELS
  TICKETS
  GIVEAWAYS
  VERIFICATION
  QUARANTINE
  ANTI_NUKE
  HONEYPOT
  ROLE_PERSISTENCE
  SCHEDULED_MESSAGES
  POLLS
  SUGGESTIONS
  ECONOMY
  COUNTING_GAME
  TRIVIA
  CASINO
  INVITE_TRACKING
  MODMAIL
  PLAYER_REPORTS
  PERM_WATCH
  CHANNEL_LOCKS
  STAT_CHANNELS
  AI_CHAT
  AI_MODERATION
  SERVER_BACKUP
  ANNOUNCEMENTS
  SLOW_MODE
  BIRTHDAYS
  APPLICATIONS
  STATUS_CHANNEL
  WARN_ESCALATION
  BAN_APPEALS
  MOD_DIGEST
  VOICE_ACTIVITY
  WEEKLY_RECAP
  ACHIEVEMENTS
  GROWTH_ANALYTICS
  SERVER_TEMPLATES
  BUMP_REMINDER
  SUGGESTION_ANALYTICS
  RANK_CARDS
  CONFESSIONS
  MEMBER_MILESTONES
  RULES_GATE
  PRESTIGE
  REMINDERS
  LFG
  EMBED_CREATOR
  SUPPORT_INTAKE
}

model GrowthSnapshot {
  id           String   @id @default(cuid())
  guild        Guild    @relation(fields: [guildId], references: [id])
  guildId      String
  memberCount  Int
  messageCount Int
  createdAt    DateTime @default(now())

  @@index([guildId, createdAt])
}

// ---- Bump Reminder ----
// Detects Disboard's "Bump done!" confirmation embed in chat, then pings
// the configured channel again once the 2-hour cooldown expires — checked
// by a cron job (not setTimeout) specifically so it survives a bot restart.

model BumpReminderSettings {
  id             String    @id @default(cuid())
  guild          Guild     @relation(fields: [guildId], references: [id])
  guildId        String    @unique
  channelId      String?
  mentionRoleId  String?
  nextReminderAt DateTime?
  reminded       Boolean   @default(true) // true = nothing pending; set false the moment a bump is detected
}

// ---- Suggestion Analytics ----
// A periodic digest of the most-reacted suggestions — reaction counts
// aren't persisted anywhere (Suggestion has no vote columns), so the job
// that uses this reads them live off the Discord message each time.

model SuggestionAnalyticsSettings {
  id        String  @id @default(cuid())
  guild     Guild   @relation(fields: [guildId], references: [id])
  guildId   String  @unique
  channelId String?
}

model DailyMessageCount {
  id      String   @id @default(cuid())
  guildId String
  date    DateTime @db.Date
  count   Int      @default(0)

  @@unique([guildId, date])
}

model ModuleToggle {
  id      String    @id @default(cuid())
  guild   Guild     @relation(fields: [guildId], references: [id])
  guildId String
  key     ModuleKey
  enabled Boolean   @default(false)
  config  Json?

  @@unique([guildId, key])
  @@index([guildId])
}

model WelcomeConfig {
  id           String  @id @default(cuid())
  guild        Guild   @relation(fields: [guildId], references: [id])
  guildId      String  @unique
  channelId    String?
  welcomeText  String?
  goodbyeText  String?
  embedColor   String? @default("#00E5FF")
  embedEnabled Boolean @default(false)
  embedTitle   String?
  buttons      Json    @default("[]")
  embedExtra   Json? // author/thumbnail/image/footer-icon/timestamp/fields — see apps/web/lib/embedExtra.ts for the shared shape
  savedEmbedId String? // when set, overrides embedTitle/embedExtra/etc. with an EmbedCreatorPreset's content at send time
}

// A pool of alternate join messages — when at least one is enabled, the bot
// picks one at random per join instead of always using WelcomeConfig's
// single welcomeText, each with its own "wave" button so another member can
// publicly greet the new one. Tied to Guild directly (not WelcomeConfig)
// since a guild can add greetings before ever saving the main Welcome
// settings. Leaving the pool empty keeps the single welcomeText behavior
// unchanged, so this is purely additive.
model WelcomeGreeting {
  id          String   @id @default(cuid())
  guild       Guild    @relation(fields: [guildId], references: [id])
  guildId     String
  text        String
  buttonLabel String   @default("👋 Wave to say hi!")
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([guildId])
}

model CustomCommand {
  id           String   @id @default(cuid())
  guild        Guild    @relation(fields: [guildId], references: [id])
  guildId      String
  trigger      String
  response     String
  embedEnabled Boolean  @default(false)
  embedTitle   String?
  embedColor   String?
  buttons      Json     @default("[]")
  embedExtra   Json?
  savedEmbedId String?
  createdAt    DateTime @default(now())

  @@unique([guildId, trigger])
}

model StreamSubscription {
  id                String    @id @default(cuid())
  guild             Guild     @relation(fields: [guildId], references: [id])
  guildId           String
  platform          String // "twitch" | "youtube"
  channelName       String
  announceChannelId String
  isLive            Boolean   @default(false)
  lastNotifiedAt    DateTime?

  @@index([guildId])
}

model MemberXp {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  userId    String
  xp        Int      @default(0)
  level     Int      @default(0)
  prestige  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp])
}

// ---- Raid Helper / Event Coordination ----

enum EventStatus {
  SCHEDULED
  REMINDED
  COMPLETED
  CANCELLED
}

model Event {
  id                    String        @id @default(cuid())
  guild                 Guild         @relation(fields: [guildId], references: [id])
  guildId               String
  title                 String
  description           String?
  channelId             String
  messageId             String?
  createdById           String
  startTime             DateTime
  status                EventStatus   @default(SCHEDULED)
  reminderMinutesBefore Int           @default(15)
  embedEnabled          Boolean       @default(true)
  embedColor            String?       @default("#00E5FF")
  buttons               Json          @default("[]")
  embedExtra            Json?
  // Which RSVP role buttons show on the event (and correspondingly which
  // stat fields the embed shows) — e.g. a simple meetup might only want
  // Attending/Absent, not the raid roles.
  enabledRoles          Json          @default("[\"TANK\",\"DPS\",\"HEALER\",\"ATTENDING\",\"ABSENT\"]")
  needsSync             Boolean       @default(true) // true = bot must (re)post/edit the Discord message
  discordEventId        String? // native Discord "Scheduled Event" (Events tab) mirroring this — separate from messageId's RSVP embed
  signups               EventSignup[]
  createdAt             DateTime      @default(now())

  @@index([guildId, startTime])
}

enum SignupRole {
  TANK
  DPS
  HEALER
  ATTENDING
  ABSENT
  TENTATIVE
}

model EventSignup {
  id         String     @id @default(cuid())
  event      Event      @relation(fields: [eventId], references: [id])
  eventId    String
  userId     String
  role       SignupRole
  reminded   Boolean    @default(false)
  signedUpAt DateTime   @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}

model ButtonPreset {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  name      String
  buttons   Json     @default("[]")
  createdAt DateTime @default(now())

  @@unique([guildId, name])
}

model SavedEmbed {
  id               String   @id @default(cuid())
  guild            Guild    @relation(fields: [guildId], references: [id])
  guildId          String
  name             String
  content          String?
  embedEnabled     Boolean  @default(true)
  embedTitle       String?
  embedDescription String?
  embedColor       String?  @default("#00E5FF")
  buttons          Json     @default("[]")
  embedExtra       Json?
  createdAt        DateTime @default(now())

  @@unique([guildId, name])
}

model EventTemplate {
  id                    String   @id @default(cuid())
  guild                 Guild    @relation(fields: [guildId], references: [id])
  guildId               String
  name                  String
  title                 String
  description           String?
  reminderMinutesBefore Int      @default(15)
  embedEnabled          Boolean  @default(true)
  embedColor            String?  @default("#00E5FF")
  buttons               Json     @default("[]")
  embedExtra            Json?
  enabledRoles          Json     @default("[\"TANK\",\"DPS\",\"HEALER\",\"ATTENDING\",\"ABSENT\"]")
  createdAt             DateTime @default(now())

  @@unique([guildId, name])
}

model EventSettings {
  id                String  @id @default(cuid())
  guild             Guild   @relation(fields: [guildId], references: [id])
  guildId           String  @unique
  defaultChannelId  String?
  defaultReminder   Int     @default(15)
  mentionRoleId     String?
}

// ---- Logging ----

model LoggingConfig {
  id             String   @id @default(cuid())
  guild          Guild    @relation(fields: [guildId], references: [id])
  guildId        String   @unique
  logChannelId   String?

  // Moderation Events
  logMemberMuted    Boolean @default(true)
  logMemberUnmuted  Boolean @default(true)
  logModerationBan  Boolean @default(true)
  logModerationUnban Boolean @default(true)

  // Message Events
  logEdits        Boolean @default(true)
  logDeletes      Boolean @default(true)
  logInvitePosted Boolean @default(false)

  // Member Events
  logNicknameChanged Boolean @default(false)
  logMemberBanned    Boolean @default(true)
  logJoinsLeaves     Boolean @default(true) // covers both member joined + left
  logMemberUnbanned  Boolean @default(true)
  logUserUpdated     Boolean @default(false)

  // Role Events
  logRoleCreated       Boolean @default(false)
  logRoleUpdated       Boolean @default(false)
  logRoleDeleted       Boolean @default(false)
  logMemberRolesChanged Boolean @default(false)

  // Voice Events
  logVoice Boolean @default(false) // covers join + leave + move

  // Server Events
  logServerEdited  Boolean @default(false)
  logEmojisUpdated Boolean @default(false)

  // Channel Events
  logChannelCreated Boolean @default(false)
  logChannelUpdated Boolean @default(false)
  logChannelDeleted Boolean @default(false)

  // Ignored / Additional settings
  ignoredChannelIds Json    @default("[]")
  ignoreBots        Boolean @default(true)
  hideThumbnails    Boolean @default(false)
}

// ---- Anti-Raid ----

model AntiRaidConfig {
  id                String  @id @default(cuid())
  guild             Guild   @relation(fields: [guildId], references: [id])
  guildId           String  @unique
  alertChannelId    String?
  joinRateLimit     Int     @default(10) // members
  joinRateWindowSec Int     @default(30)
  minAccountAgeDays Int     @default(3)
  autoLockdown      Boolean @default(false)
}

// ---- Reaction Roles ----
// A panel is the message itself (channel + optional title/description/embed
// styling), posted automatically by reactionRolePoster.ts the moment it's
// created — messageId starts null and gets filled in once posted, same
// "poster job fills in messageId" pattern as RolePanel below. Each
// ReactionRole row is one emoji->role mapping that belongs to a panel; the
// poster job seeds the bot's own reaction for every option once the message
// exists, and the reaction add/remove listeners match purely on
// messageId+emoji so they didn't need to change when this got a panel layer.

model ReactionRolePanel {
  id           String         @id @default(cuid())
  guild        Guild          @relation(fields: [guildId], references: [id])
  guildId      String
  channelId    String
  messageId    String?
  title        String?
  description  String?
  embedEnabled Boolean        @default(false)
  embedColor   String?
  embedExtra   Json?
  savedEmbedId String? // shared Embed Creator preset used as the message body, resolved live at post time
  notifyMode String @default("PRIVATE") // PRIVATE (hidden reply / short-lived message) | DM | NONE
  createdAt    DateTime       @default(now())
  options      ReactionRole[]

  @@index([guildId])
}

model ReactionRole {
  id        String            @id @default(cuid())
  guild     Guild             @relation(fields: [guildId], references: [id])
  guildId   String
  panel     ReactionRolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  panelId   String
  channelId String
  messageId String?
  emoji     String
  // roleId is the first role granted ("" when the option only grants channel
  // access); extraRoleIds/channelIds hold any further roles and the channels
  // this reaction unlocks for the member (a per-member view permission).
  roleId    String
  extraRoleIds Json @default("[]")
  channelIds   Json @default("[]")

  @@unique([messageId, emoji])
  @@index([guildId])
  @@index([panelId])
}

// ---- Join Roles ----

model JoinRole {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  roleId  String

  @@unique([guildId, roleId])
}

// ---- Sticky Messages ----

model StickyMessage {
  id               String  @id @default(cuid())
  guild            Guild   @relation(fields: [guildId], references: [id])
  guildId          String
  channelId        String  @unique
  content          String
  lastMessageId    String?
  embedEnabled     Boolean @default(false)
  embedTitle       String?
  embedDescription String?
  embedColor       String? // hex, e.g. "#5865F2"
  // Link buttons only (label + url) — no custom_id, so no interaction
  // handler is needed on the bot side. [{ "label": string, "url": string }]
  buttons          Json    @default("[]")
  embedExtra       Json?
  savedEmbedId     String?
}

// ---- Starboard ----

model StarboardConfig {
  id          String @id @default(cuid())
  guild       Guild  @relation(fields: [guildId], references: [id])
  guildId     String @unique
  channelId   String?
  threshold   Int    @default(5)
}

model StarredMessage {
  id                String @id @default(cuid())
  guild             Guild  @relation(fields: [guildId], references: [id])
  guildId           String
  originalMessageId String
  starboardMessageId String?
  starCount         Int    @default(0)

  @@unique([guildId, originalMessageId])
}

// ---- Temp Channels ----

model TempChannelLobby {
  id               String  @id @default(cuid())
  guild            Guild   @relation(fields: [guildId], references: [id])
  guildId          String
  name             String
  lobbyChannelId   String
  categoryId       String?
  nameFormat       String  @default("Channel")
  userLimit        Int     @default(0)
  bitrate          Int     @default(64000)
  deleteAfterEmptySec Int  @default(0)
  pairTextChannel  Boolean @default(false)
  hideTextFromNonMembers Boolean @default(true)

  @@index([guildId])
}

model TempChannelInstance {
  id         String   @id @default(cuid())
  guild      Guild    @relation(fields: [guildId], references: [id])
  guildId    String
  lobbyId    String
  channelId  String
  textChannelId String?
  ownerId    String
  createdAt  DateTime @default(now())

  @@index([guildId])
}

// ---- Tickets ----

enum TicketPanelLayout {
  BUTTONS
  DROPDOWN
}

model TicketPanel {
  id            String            @id @default(cuid())
  guild         Guild             @relation(fields: [guildId], references: [id])
  guildId       String
  name          String
  channelId     String
  layout        TicketPanelLayout @default(BUTTONS)
  typeIds       Json              @default("[]") // ordered TicketType ids offered on this panel
  description   String?
  paused        Boolean           @default(false)
  messageId     String?
  ticketCounter Int               @default(0) // per-panel sequential ticket numbering

  // Legacy single-type fields, kept for panels created before ticket types existed.
  categoryId    String?
  buttonLabel   String            @default("Open a Ticket")
  supportRoleId String?
  savedEmbedId  String? // overrides name/description above with a shared Embed Creator preset, resolved live at send time — the open-ticket button/select row still always posts alongside it

  @@index([guildId])
}

model TicketType {
  id             String   @id @default(cuid())
  guild          Guild    @relation(fields: [guildId], references: [id])
  guildId        String
  name           String
  emoji          String?
  description    String?
  categoryId     String?
  staffRoleIds   Json     @default("[]")
  openMessage    String?
  modalFields    Json     @default("[]") // [{ label, placeholder, required, style }]
  autoCloseHours Int?
  slaMinutes     Int?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Overrides the guild-wide defaults on TicketSettings for tickets opened
  // under this type — null falls back to the guild default.
  transcriptChannelId String?
  closeBehavior       TicketCloseBehavior?

  @@index([guildId])
}

enum TicketCloseBehavior {
  DELETE_AND_DM // delete the ticket channel and DM the opener a copy of the transcript
  POST_ONLY // leave the channel alone; just post the transcript
}

enum TicketStatus {
  OPEN
  CLAIMED
  CLOSED
}

model Ticket {
  id           String       @id @default(cuid())
  guild        Guild        @relation(fields: [guildId], references: [id])
  guildId      String
  panelId      String
  typeId       String?
  ticketNumber Int
  channelId    String
  userId       String
  claimedById  String?
  status       TicketStatus @default(OPEN)
  priority     String?
  tags         Json         @default("[]")
  closeReason  String?
  transcriptUrl String?
  feedbackRating Int?
  createdAt    DateTime     @default(now())
  closedAt     DateTime?

  @@index([guildId, status])
}

model TicketTag {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  name    String
  color   String @default("#5865F2")

  @@index([guildId])
}

model TicketCannedResponse {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  title   String
  content String

  @@index([guildId])
}

model TicketKnowledgeBase {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  name    String
  content String

  @@index([guildId])
}

model TicketSettings {
  id                  String  @id @default(cuid())
  guild               Guild   @relation(fields: [guildId], references: [id])
  guildId             String  @unique
  logChannelId        String?
  transcriptChannelId String?
  closeBehavior       TicketCloseBehavior @default(DELETE_AND_DM)
  channelNameFormat   String  @default("ticket-{user}")
  ticketCap           Int     @default(0)
  requireCloseReason  Boolean @default(false)
  supportRoleIds      Json    @default("[]")
  blacklistUserIds    Json    @default("[]")
  blacklistRoleIds    Json    @default("[]")
}

// ---- Giveaways ----

model Giveaway {
  id          String   @id @default(cuid())
  guild       Guild    @relation(fields: [guildId], references: [id])
  guildId     String
  channelId   String
  messageId   String?
  prize       String
  description String?
  embedColor  String?  @default("#B14BFF")
  imageUrl    String?
  buttons     Json     @default("[]")
  embedExtra  Json?
  savedEmbedId String?
  winnerCount Int      @default(1)
  endsAt      DateTime
  ended       Boolean  @default(false)
  entries     GiveawayEntry[]

  @@index([guildId, endsAt])
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id])
  giveawayId String
  userId     String

  @@unique([giveawayId, userId])
}

// ---- Moderation Cases (persistent history behind /kick /ban /mute /warn) ----

enum CaseAction {
  WARN
  MUTE
  KICK
  BAN
  UNBAN
  UNMUTE
}

model ModerationCase {
  id          String     @id @default(cuid())
  guild       Guild      @relation(fields: [guildId], references: [id])
  guildId     String
  caseNumber  Int
  userId      String
  action      CaseAction
  reason      String?
  moderatorId String
  createdAt   DateTime   @default(now())

  @@unique([guildId, caseNumber])
  @@index([guildId, userId])
}

// ---- Verification ----

model VerificationConfig {
  id             String  @id @default(cuid())
  guild          Guild   @relation(fields: [guildId], references: [id])
  guildId        String  @unique
  verifiedRoleId String?
  minAccountAgeDays Int  @default(0)
}

// ---- Quarantine ----

model QuarantineRecord {
  id            String   @id @default(cuid())
  guild         Guild    @relation(fields: [guildId], references: [id])
  guildId       String
  userId        String
  reason        String?
  quarantinedBy String
  previousRoles String[] // role IDs to restore on release
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([guildId, active])
}

// ---- Anti-Nuke ----

model AntiNukeConfig {
  id                String  @id @default(cuid())
  guild             Guild   @relation(fields: [guildId], references: [id])
  guildId           String  @unique
  alertChannelId    String?
  maxBansPerMinute  Int     @default(3)
  maxChannelDeletesPerMinute Int @default(3)
  stripRolesOnTrigger Boolean @default(true)
}

// ---- Honeypot ----

model HoneypotConfig {
  id        String  @id @default(cuid())
  guild     Guild   @relation(fields: [guildId], references: [id])
  guildId   String  @unique
  channelId String?
}

// ---- Role Persistence ----

model RoleSnapshot {
  id      String   @id @default(cuid())
  guild   Guild    @relation(fields: [guildId], references: [id])
  guildId String
  userId  String
  roleIds String[]
  savedAt DateTime @default(now())

  @@unique([guildId, userId])
}

// ---- Scheduled Messages ----

model ScheduledMessage {
  id            String    @id @default(cuid())
  guild         Guild     @relation(fields: [guildId], references: [id])
  guildId       String
  channelId     String
  content       String
  cronExpr      String // e.g. "0 9 * * 1" (every Monday 9am)
  lastSentAt    DateTime?

  @@index([guildId])
}

// ---- Polls ----

enum PollDurationMode {
  TIMER
  MANUAL
}

model Poll {
  id           String           @id @default(cuid())
  guild        Guild            @relation(fields: [guildId], references: [id])
  guildId      String
  channelId    String
  messageId    String?
  question     String
  options      String[] // display labels, indexed by position
  emojis       String[] // reaction emoji per option, same index as options — what members actually click to vote
  color        String?          @default("#00E5FF") // the embed's left border accent
  barColor     String?          @default("#00E5FF") // the dashboard's own result-bar fill — Discord embeds can't color plain text, so this only affects the dashboard views, not the live Discord message
  isPrivate    Boolean          @default(false) // hides the tally/percentages in the embed itself until the poll closes
  durationMode PollDurationMode @default(MANUAL)
  endsAt       DateTime? // set only when durationMode = TIMER
  closed       Boolean          @default(false)
  closedAt     DateTime?
  allowWriteIn Boolean          @default(false) // adds a "✍️ Write In" button that opens a modal to collect a free-text answer instead of one of the fixed options
  createdAt    DateTime         @default(now())
  votes        PollVote[]
  writeIns     PollWriteIn[]

  @@index([guildId])
  @@index([messageId])
}

model PollVote {
  id     String @id @default(cuid())
  poll   Poll   @relation(fields: [pollId], references: [id])
  pollId String
  userId String
  emoji  String // which option's emoji this user last voted with — one vote per user, switching replaces it

  @@unique([pollId, userId])
}

// A member's own typed answer, collected through the poll's "✍️ Write In"
// button and modal (not a DM — a modal only opens from a real interaction,
// and a DM collector was colliding with other DM-driven modules like
// Support DM/Modmail/Applications, which all listen on every DM). Kept
// separate from PollVote since it's free text, not one of the fixed
// options, and shown as its own list on the dashboard.
model PollWriteIn {
  id        String   @id @default(cuid())
  poll      Poll     @relation(fields: [pollId], references: [id])
  pollId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  @@index([pollId])
}

// ---- Suggestions ----

enum SuggestionStatus {
  PENDING
  APPROVED
  DENIED
}

model Suggestion {
  id        String           @id @default(cuid())
  guild     Guild            @relation(fields: [guildId], references: [id])
  guildId   String
  channelId String
  messageId String?
  userId    String
  content   String
  status    SuggestionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([guildId, status])
}

// ---- Economy ----

model EconomyConfig {
  id           String  @id @default(cuid())
  guild        Guild   @relation(fields: [guildId], references: [id])
  guildId      String  @unique
  currencyName String  @default("Coins")
  currencyIcon String  @default("🪙")
  embedColor   String  @default("#E8C547")
  maxBalance   Int     @default(1000000000)

  earnOnMessages    Boolean @default(true)
  messageEarnMin    Int     @default(2)
  messageEarnMax    Int     @default(6)
  messageCooldownSec Int    @default(60)
  minMessageLength  Int     @default(4)

  dailyEnabled   Boolean @default(true)
  dailyAmount    Int     @default(200)
  streakBonusPerDay Int  @default(0)
  streakCapDays  Int     @default(7)

  transfersEnabled   Boolean @default(true)
  transferMinAmount  Int     @default(1)
  transferTaxPercent Int     @default(0)

  channelMultipliers Json @default("[]") // [{ channelId, multiplier }]
  roleMultipliers    Json @default("[]") // [{ roleId, multiplier }]

  maxBet       Int     @default(5000)
}

model EconomyBalance {
  id             String    @id @default(cuid())
  guild          Guild     @relation(fields: [guildId], references: [id])
  guildId        String
  userId         String
  balance        Int       @default(0)
  totalEarned    Int       @default(0)
  totalSpent     Int       @default(0)
  dailyStreak    Int       @default(0)
  lastDailyClaim DateTime?
  lastMessageEarnAt DateTime?

  @@unique([guildId, userId])
  @@index([guildId, balance])
}

model EconomyTransaction {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  userId    String
  amount    Int // positive = earned, negative = removed/spent
  reason    String // "message" | "daily" | "transfer_in" | "transfer_out" | "transfer_tax" | "casino" | "admin"
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

// ---- Level Roles / XP Blacklist ----

model LevelRole {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  level   Int
  roleId  String

  @@unique([guildId, level])
}

// Where level-up announcements post — without this, the bot just posts in
// whatever channel the XP-earning message happened to be sent in.
model LevelingSettings {
  id             String  @id @default(cuid())
  guild          Guild   @relation(fields: [guildId], references: [id])
  guildId        String  @unique
  channelId      String?
  levelUpMessage String  @default("🎉 {user} just reached **Level {level}**!")
}

enum XpBlacklistType {
  CHANNEL
  ROLE
}

model XpBlacklistEntry {
  id       String          @id @default(cuid())
  guild    Guild           @relation(fields: [guildId], references: [id])
  guildId  String
  targetId String
  type     XpBlacklistType

  @@unique([guildId, targetId])
}

// ---- Counting Game ----

model CountingGameConfig {
  id             String  @id @default(cuid())
  guild          Guild   @relation(fields: [guildId], references: [id])
  guildId        String  @unique
  channelId      String?
  currentCount   Int     @default(0)
  lastUserId     String?
  resetOnMistake Boolean @default(true)
  highScore      Int     @default(0)
}

// ---- Invite Tracking ----

model InviteStat {
  id        String @id @default(cuid())
  guild     Guild  @relation(fields: [guildId], references: [id])
  guildId   String
  inviterId String
  uses      Int    @default(0)

  @@unique([guildId, inviterId])
}

// ---- Modmail ----

model ModmailThread {
  id         String   @id @default(cuid())
  guild      Guild    @relation(fields: [guildId], references: [id])
  guildId    String
  userId     String
  channelId  String // staff-side thread channel
  subject    String?
  open       Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([guildId, open])
}

// ---- Server Partnerships ----

model ServerPartnership {
  id            String   @id @default(cuid())
  guild         Guild    @relation(fields: [guildId], references: [id])
  guildId       String
  partnerName   String
  partnerInvite String?
  type          String // "Ad Exchange" | "Full Alliance" etc
  since         DateTime @default(now())
}

// ---- Player Reports ----

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
}

model PlayerReport {
  id             String       @id @default(cuid())
  guild          Guild        @relation(fields: [guildId], references: [id])
  guildId        String
  reporterId     String
  reportedUserId String
  reason         String
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  @@index([guildId, status])
}

// ---- Perm Watch ----

model PermWatchConfig {
  id             String  @id @default(cuid())
  guild          Guild   @relation(fields: [guildId], references: [id])
  guildId        String  @unique
  alertChannelId String?
}

// ---- Channel Locks ----

model ChannelLock {
  id                String   @id @default(cuid())
  guild             Guild    @relation(fields: [guildId], references: [id])
  guildId           String
  channelId         String   @unique
  allowImages       Boolean  @default(true)
  allowLinks        Boolean  @default(true)
  allowFiles        Boolean  @default(true)
  allowMessages     Boolean  @default(true) // if false, only images/links/files/commands per the other toggles are allowed through
  slashCommandsOnly Boolean  @default(false) // deletes every regular message, only slash command usage is untouched
  // When slashCommandsOnly is on and this is non-empty, only these specific
  // slash command names are allowed through — anything else gets refused
  // before it runs (interactions can't be "deleted" the way a message can).
  // Empty means every slash command is allowed, same as before this existed.
  allowedCommands   Json     @default("[]")
  // Messages must start with one of these to survive (in addition to
  // whatever the other toggles already allow) — empty means no requirement.
  requiredPrefixes  Json     @default("[]")
  bannedWords       Json     @default("[]")
  // A non-empty allowlist restricts who can post a regular message here at
  // all — anyone whose id isn't listed and holds none of the listed roles
  // gets deleted immediately, before the allowImages/allowLinks/etc. checks
  // even run. A bot is just a user id here, same as a member. Empty means
  // no restriction (anyone allowed by the other toggles can post).
  allowedUserIds    Json     @default("[]")
  allowedRoleIds    Json     @default("[]")

  // When a regular message gets deleted for breaking one of the rules
  // above, this posts a small button in-channel; clicking it (only the
  // affected member can meaningfully do so) reveals notifyContent as a
  // real Discord ephemeral reply — the same "Only you can see this ·
  // Dismiss message" treatment Discord gives a slash command's ephemeral
  // reply, which is otherwise impossible for a plain message with no
  // interaction attached to it.
  notifyEnabled Boolean @default(false)
  notifyContent String? @default("{user}, that message isn't allowed in {channel}.")

  createdAt         DateTime @default(now())
}

// ---- Error Log ----
// Deliberately not a relation to Guild — an error can happen before a
// guild row exists (that's sometimes exactly the bug being logged), or
// entirely outside any guild context (auth failures, startup errors).

model ErrorLog {
  id        String   @id @default(cuid())
  guildId   String?
  source    String // "api" | "bot"
  message   String
  stack     String?
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

// ---- Dashboard Access Control ----
// Account-wide (not per-guild) — the whole dashboard is invite-only.
// req.user.id matching OWNER_DISCORD_ID always passes regardless of this
// table (see apps/api/src/middleware/requireAuth.ts); everyone else needs
// a row here. `plan` has no billing logic behind it yet — it exists so a
// future paid tier can gate a module with one field check instead of a
// schema change.

model DashboardAccess {
  id             String   @id @default(cuid())
  discordUserId  String   @unique
  username       String // captured at grant time, for the owner's own reference in the UI
  plan           String   @default("FREE") // FREE | PAID
  grantedAt      DateTime @default(now())
}

model AccessRequest {
  id            String   @id @default(cuid())
  discordUserId String   @unique
  username      String
  message       String? // why they want access, shown to the owner in the DM and the Access Control page
  requestedAt   DateTime @default(now())
}

// ---- Access Audit Log ----
// One row per access-control decision — who was approved/denied/granted/
// revoked/re-planned, and when. Both the HTTP routes (apps/api/src/routes/
// access.ts) and the DM button handlers (apps/bot/src/modules/owner/
// accessRequests.ts) write here, since either path can make these changes.

model AccessAuditEntry {
  id            String   @id @default(cuid())
  discordUserId String
  username      String
  action        String // APPROVED | DENIED | GRANTED | REVOKED | PLAN_CHANGED | REVOKED_ALL
  detail        String? // e.g. the new plan value, or "via Discord DM"
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ---- Confessions ----
// Anonymous message relay — /confess posts the content to channelId with
// no author info attached, numbered sequentially per guild.

model ConfessionSettings {
  id        String  @id @default(cuid())
  guild     Guild   @relation(fields: [guildId], references: [id])
  guildId   String  @unique
  channelId String?
  nextNumber Int    @default(1)
}

// ---- Member Milestones ----
// Join-date anniversaries (1 year, 2 years, ...), checked daily — distinct
// from Birthdays, which tracks a date the member entered themselves.

model MilestoneSettings {
  id        String  @id @default(cuid())
  guild     Guild   @relation(fields: [guildId], references: [id])
  guildId   String  @unique
  channelId String?
}

// ---- Rules Gate ----
// A single "I Agree" button on a posted rules message — clicking grants
// roleId. Distinct from Verification (which is about proving you're not a
// bot / account age), this is about confirming the rules were read.

model RulesGateSettings {
  id        String  @id @default(cuid())
  guild     Guild   @relation(fields: [guildId], references: [id])
  guildId   String  @unique
  channelId String?
  messageId String?
  roleId    String?
}

// ---- Prestige ----
// Once a member hits maxLevel, /prestige resets their MemberXp back to
// level 0 (keeping the running prestige count) and optionally grants a
// per-prestige role — keeps a long-lived leaderboard from going stale
// once the earliest members are permanently far ahead of everyone else.

model PrestigeSettings {
  id       String  @id @default(cuid())
  guild    Guild   @relation(fields: [guildId], references: [id])
  guildId  String  @unique
  maxLevel Int     @default(50)
  roleId   String?
}

// ---- Reminders ----
// Personal /remindme entries — checked by a minutely cron job, DMed back
// to the user (falling back to the channel it was set in if the DM
// fails), then deleted.

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  guildId   String?
  channelId String
  message   String
  remindAt  DateTime
  createdAt DateTime @default(now())

  @@index([remindAt])
}

// ---- Bot Customization ----
// Account-wide, not per-guild — a bot's username/avatar/presence/
// description are Discord application-level settings, the same across
// every server it's in. Always exactly one row (id "singleton").

model BotConfig {
  id              String    @id @default("singleton")
  username        String?
  description     String?
  statusType      String    @default("online") // online | idle | dnd | invisible
  activityType    String    @default("PLAYING") // PLAYING | WATCHING | LISTENING | COMPETING | CUSTOM
  activityText    String?
  lastHeartbeatAt DateTime? // written every ~20s by the running bot process; the dashboard/status channel treat this as stale (offline) after ~60s
  lastDeployCommit String?  // RENDER_GIT_COMMIT at last boot — comparing this on startup is how a "new deploy" is detected
  lastDeployAt     DateTime?
  deployingSince   DateTime? // set right before `prisma migrate deploy` runs, cleared by the next heartbeat — see apps/api/src/routes/botStatus.ts
  manualStatusOverride String? // "ONLINE" | "OFFLINE" | "MAINTENANCE" | null — null means fully automatic (heartbeat-based). Owner-set, takes precedence over everything else.
  manualStatusMessage  String? // shown alongside the override everywhere the status appears
  supportServerPickerMessage String? // Support DM Intake: shown when a member shares multiple servers with the module enabled, before any one is picked — account-wide like everything else on this model, since no single server's settings could own it
  updatedAt       DateTime  @updatedAt
}

// ---- Server Stat Channels ----
// Voice channels renamed periodically to show a live count (member count,
// boost count, etc) — Discord caps channel renames at ~2/10min per
// channel, so the bot job updates these on a slow interval, not live.

model StatChannel {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  channelId String   @unique
  statType  String // MEMBER_COUNT | BOOST_COUNT | CHANNEL_COUNT
  format    String   @default("{stat}: {count}")
  createdAt DateTime @default(now())
}

// ---- Status Channel (Utility) ----
// A live embed posted to a chosen text channel showing whether the bot is
// currently online, edited in place on a short interval (reuses
// BotConfig.lastHeartbeatAt as the source of truth).

model StatusChannel {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  channelId String   @unique
  messageId String?
  createdAt DateTime @default(now())
}

// ---- Alert Settings ----
// Per-guild channel picks for operational notices — configured from two
// places in the dashboard (Errors page: error/deploy; Status Channel page:
// uptime history) but stored together since they're all "where should
// Spartacus post about itself" settings for that server.

model AlertSettings {
  id              String  @id @default(cuid())
  guild           Guild   @relation(fields: [guildId], references: [id])
  guildId         String  @unique
  errorChannelId  String? // new ErrorLog rows for this guild get posted here as an embed
  deployChannelId String? // posted once per new production deploy (detected via RENDER_GIT_COMMIT change)
  uptimeChannelId String? // a running log of bot went-offline / back-online events, distinct from the live status embed
}

// ---- Uptime Incidents ----
// One row per bot outage, opened when the heartbeat goes stale and closed
// when it recovers — global, not per guild, since the bot is a single
// process shared by every server. Backs the uptime-history channel posts.

model UptimeIncident {
  id        String    @id @default(cuid())
  startedAt DateTime  @default(now())
  endedAt   DateTime?
}

// ---- AI Chat + Moderation ----
// One config row per guild — AI_CHAT and AI_MODERATION are gated by the
// normal module toggle system, this just holds the extra settings each
// needs. Requires ANTHROPIC_API_KEY to be set on the bot process; if it
// isn't, both features log an error and no-op rather than crash anything.

model AiConfig {
  id                String  @id @default(cuid())
  guild             Guild   @relation(fields: [guildId], references: [id])
  guildId           String  @unique
  chatChannelId     String? // null = respond anywhere the bot is @-mentioned
  chatSystemPrompt  String?
  moderationEnabled Boolean @default(false)
}

// ---- Server Backup ----

model ServerBackup {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  name      String
  data      Json // snapshot of roles + channels at backup time
  createdAt DateTime @default(now())
}

// ---- Per-Command Toggles ----
// Independent of the module toggle system — a whole module can stay on
// while one specific slash command inside it is switched off. Only rows
// for explicitly-disabled commands are stored; anything with no row here
// is enabled by default.

model CommandToggle {
  id          String  @id @default(cuid())
  guild       Guild   @relation(fields: [guildId], references: [id])
  guildId     String
  commandName String
  enabled     Boolean @default(true)

  @@unique([guildId, commandName])
}

// ---- Custom Slash Command Builder ----
// User-created, per-guild slash commands — registered live as real Discord
// guild commands (not the built-in static ones), each running one preset
// action. discordCommandId is what Discord assigns on registration, needed
// to update/delete the live command later.

model CustomSlashCommand {
  id               String  @id @default(cuid())
  guild            Guild   @relation(fields: [guildId], references: [id])
  guildId          String
  name             String
  description      String
  discordCommandId String?
  actionType       String // SEND_MESSAGE | GIVE_ROLE | REMOVE_ROLE | ADD_CURRENCY | POST_EMBED
  ephemeralReply   Boolean @default(true)
  messageText      String? // SEND_MESSAGE
  roleId           String? // GIVE_ROLE / REMOVE_ROLE
  currencyAmount   Int? // ADD_CURRENCY
  embedEnabled     Boolean @default(false) // POST_EMBED
  embedTitle       String?
  embedDescription String?
  embedColor       String?
  buttons          Json    @default("[]")
  embedExtra       Json?
  savedEmbedId     String?
  createdAt        DateTime @default(now())

  @@unique([guildId, name])
}

// ---- LFG (Looking For Group) ----
// Each command is registered as a real Discord guild slash command (same
// mechanism as CustomSlashCommand above, discordCommandId lets us clean it
// up on delete/rename) AND matched against a "!trigger" text prefix in
// messageCreate.ts — same trigger word drives both. A command is locked to
// exactly one channel (@@unique guildId+channelId) so two commands can never
// both fire in the same channel, but a guild can have any number of
// commands, each with its own channel. Posting mode is either a plain-text
// template or a full embed (title/description/color + the shared
// embedExtra author/thumbnail/image/footer/fields set) — never both.
model LfgCommand {
  id                  String   @id @default(cuid())
  guild               Guild    @relation(fields: [guildId], references: [id])
  guildId             String
  trigger             String // used as both the "!trigger" prefix word and the /trigger slash command name
  description         String   @default("Post that you're looking for a group.") // shown in Discord's slash command picker
  discordCommandId    String?
  channelId           String
  roleId              String? // optional role pinged alongside the sender
  includeSender       Boolean  @default(true)
  enabled             Boolean  @default(true)
  mode                String   @default("plain") // "plain" | "embed"
  message             String? // plain-text template: {user} {voice} {message}
  embedTitle          String?
  embedDescription    String?
  embedColor          String?
  embedExtra          Json?
  savedEmbedId        String?
  errorMessage        String   @default("You need to be in a voice channel to use this command.")
  wrongChannelMessage String   @default("This command can only be used in {channel}.")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  categories          LfgCategory[]

  @@unique([guildId, trigger])
  @@unique([guildId, channelId])
}

// A playlist/queue choice on one LfgCommand (e.g. "Ranked", "Standard",
// "Custom") — picked via a slash-command option, each with its own channel
// and, optionally, its own role ping and announcement text. Anything left
// blank falls back to the parent command's own setting.
model LfgCategory {
  id         String     @id @default(cuid())
  lfgCommand LfgCommand @relation(fields: [lfgCommandId], references: [id], onDelete: Cascade)
  lfgCommandId String
  guildId    String
  name       String
  channelId  String
  roleId     String?
  message    String?
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())

  @@unique([lfgCommandId, name])
}

// ---- Embed Creator ----
// A Discohook-style multi-embed message composer, and — since every other
// embed-producing feature can now point at one of these instead of building
// its own embed editor — the single shared library of saved embeds for the
// whole dashboard. Deliberately stored as one JSON blob rather than typed
// columns — the builder's shape (content, up to 10 embeds, up to 5
// component rows) is still evolving and this way adding a field to what a
// preset remembers never needs a migration.
// lastSent* tracks where THIS preset itself was last sent via the Embed
// Creator page's own Send/Update button, so "Update" there can edit that
// live message in place. A feature that references this preset via its own
// savedEmbedId (Welcome, Announcements, etc.) still sends independently
// through its own existing channel/message flow — this tracking is only
// for the preset's own direct send history.
model EmbedCreatorPreset {
  id               String   @id @default(cuid())
  guild            Guild    @relation(fields: [guildId], references: [id])
  guildId          String
  name             String
  data             Json // { content, embeds: [...], components: [...] }
  lastSentMode     String? // "bot" | "webhook"
  lastSentChannelId String?
  lastSentWebhookUrl String?
  lastSentMessageId String?
  createdAt        DateTime @default(now())

  @@unique([guildId, name])
}

// ---- Embed Creator: component actions ----
// A button or select menu's real behavior can't be embedded directly in the
// Discord message component (custom_id is capped at 100 chars, nowhere near
// enough for a role id + message text + etc.), so instead each configured
// action gets one row here, and the component's custom_id is just
// "ecaction:<id>" — created once at the moment a message actually gets
// SENT (not when the preset is saved), so it stays resolvable for as long
// as that message exists, independent of the preset being edited later.
model EmbedComponentAction {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  kind      String // "button" | "select"
  config    Json // button: {type, roleId?, currencyAmount?, messageText?, embedPresetId?, ephemeral?}
                  // select: {selectType, defaultAction?, options?: [{value, action}]}
  createdAt DateTime @default(now())

  @@index([guildId])
}

// ---- Role Panels ----
// Button/dropdown self-assignable roles — a more modern alternative to
// reaction roles, following the same panel pattern as tickets.

enum RolePanelLayout {
  BUTTONS
  DROPDOWN
}

model RolePanel {
  id           String          @id @default(cuid())
  guild        Guild           @relation(fields: [guildId], references: [id])
  guildId      String
  name         String
  channelId    String
  description  String?
  layout       RolePanelLayout @default(BUTTONS)
  options      Json            @default("[]") // [{ roleId, label, emoji }]
  messageId    String?
  embedEnabled Boolean         @default(false)
  embedColor   String?
  embedExtra   Json? // author/thumbnail/image/footer/fields — same shape as ReactionRolePanel.embedExtra, kept in sync for UI parity
  savedEmbedId String? // shared Embed Creator preset used as the message body, resolved live at post time
  notifyMode String @default("PRIVATE")

  @@index([guildId])
}

// ---- Announcements ----

model Announcement {
  id               String    @id @default(cuid())
  guild            Guild     @relation(fields: [guildId], references: [id])
  guildId          String
  channelId        String
  // Plain message content shown above the embed (if any) — optional on its
  // own; an announcement just needs at least one of this, embedTitle,
  // embedDescription, or savedEmbedId.
  content          String?
  embedEnabled     Boolean   @default(false)
  embedTitle       String?
  embedDescription String?
  embedColor       String?   @default("#00E5FF")
  buttons          Json      @default("[]")
  embedExtra       Json?
  savedEmbedId     String?
  scheduledFor     DateTime?
  sentAt           DateTime?
  messageId        String? // the live Discord message, once sent
  createdAt        DateTime  @default(now())

  @@index([guildId, sentAt])
}

// ---- Auto Purge (Moderator → Auto Purge tab) ----

model AutoPurgeConfig {
  id              String    @id @default(cuid())
  guild           Guild     @relation(fields: [guildId], references: [id])
  guildId         String
  channelId       String    @unique
  intervalSeconds Int       @default(3600) // the checking job itself only ticks every 10 minutes, so anything shorter than that isn't actually honored more often
  ignorePinned    Boolean   @default(true)
  ignoreImages    Boolean   @default(false)
  ignoreLinks     Boolean   @default(false)
  protectedEmojis Json      @default("[]") // messages carrying any of these reactions are skipped
  lastRunAt       DateTime?

  @@index([guildId])
}

// ---- Birthdays ----

model BirthdayConfig {
  id              String  @id @default(cuid())
  guild           Guild   @relation(fields: [guildId], references: [id])
  guildId         String  @unique
  channelId       String?
  embedTitle      String? @default("🎂 Happy Birthday!")
  embedMessage    String? @default("Everyone wish {user} a happy birthday! 🎉")
  embedColor      String? @default("#FF69B4")
  embedExtra      Json?
  savedEmbedId    String?
  pingRoleId      String?
  useButton       Boolean @default(false) // post a "Set My Birthday" button panel instead of relying on /birthday set alone
  buttonChannelId String?
  buttonMessageId String?
}

model Birthday {
  id      String @id @default(cuid())
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
  userId  String
  month   Int
  day     Int

  @@unique([guildId, userId])
  @@index([guildId, month, day])
}

// ---- Applications ----

enum ApplicationPanelLayout {
  BUTTONS
  DROPDOWN
}

model ApplicationPanel {
  id          String                 @id @default(cuid())
  guild       Guild                  @relation(fields: [guildId], references: [id])
  guildId     String
  name        String
  channelId   String
  description String?
  layout      ApplicationPanelLayout @default(BUTTONS)
  typeIds     Json                   @default("[]") // ordered ApplicationType ids offered on this panel
  messageId   String?
  paused      Boolean                @default(false)
  savedEmbedId String? // overrides name/description above with a shared Embed Creator preset, resolved live at send time — the apply button/select row still always posts alongside it

  @@index([guildId])
}

model ApplicationType {
  id              String   @id @default(cuid())
  guild           Guild    @relation(fields: [guildId], references: [id])
  guildId         String
  name            String
  emoji           String?
  description     String?
  reviewChannelId String?
  staffRoleIds    Json     @default("[]")
  questions       Json     @default("[]") // [{ label, style: "SHORT"|"PARAGRAPH", required }] — unlimited, asked one per DM
  introMessage    String?  // sent as the opening DM before the first question; {type} placeholder
  submittedMessage String? // sent as the DM confirmation once every question is answered; {type} placeholder
  acceptMessage   String?  @default("🎉 Your application for {type} was accepted!")
  denyMessage     String?  @default("Your application for {type} was not accepted this time.")
  customResponses Json     @default("[]") // [{ id, label, message }] — extra buttons on the review embed that just DM the applicant, no status change; capped at 3 in the UI
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([guildId])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  DENIED
}

model Application {
  id              String            @id @default(cuid())
  guild           Guild             @relation(fields: [guildId], references: [id])
  guildId         String
  panelId         String
  typeId          String?
  userId          String
  answers         Json              @default("[]") // [{ label, answer }]
  status          ApplicationStatus @default(PENDING)
  reviewedBy      String?
  reviewMessageId String?
  createdAt       DateTime          @default(now())

  @@index([guildId, status])
}

// An in-progress DM Q&A conversation, one question at a time — like the
// "Appy" bot flow, instead of Discord's 5-field-per-modal form. One active
// draft per user (across guilds, kept simple): a DM reply is matched by
// userId only, since DM channels carry no guildId of their own.
model ApplicationDraft {
  id            String   @id @default(cuid())
  guild         Guild    @relation(fields: [guildId], references: [id])
  guildId       String
  panelId       String
  typeId        String
  userId        String   @unique
  questionIndex Int      @default(0)
  answers       Json     @default("[]") // [{ label, answer }] accumulated so far
  createdAt     DateTime @default(now())
}

model ApplicationSettings {
  id             String  @id @default(cuid())
  guild          Guild   @relation(fields: [guildId], references: [id])
  guildId        String  @unique
  logChannelId   String?
  supportRoleIds Json    @default("[]")
}

// Guild-wide text for the Support DM Intake module — the one message that
// isn't per-flow, since it's sent before the member has picked a flow.
model SupportSettings {
  id           String  @id @default(cuid())
  guild        Guild   @relation(fields: [guildId], references: [id])
  guildId      String  @unique
  introMessage String?
  noFlowsMessage String?
  alreadyOpenMessage  String? // DM reply when they already have a request in progress (DRAFT/OPEN/CLAIMED)
  ticketOpenedMessage String? // DM sent right after the question chain finishes and the ticket channel is created
  ticketClaimedMessage String? // DM sent when a staff member claims their ticket
  ticketClosedMessage String? // DM sent when their ticket is closed
}

// ---- Dashboard Activity ----

// A dashboard user's pinned sidebar links for one server — synced to
// their account (keyed by Discord user id) rather than the browser, so it
// follows them between devices the way the rest of the dashboard does.
model PinnedModule {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  userId    String
  href      String
  createdAt DateTime @default(now())

  @@unique([guildId, userId, href])
  @@index([guildId, userId])
}

// A site-wide "what's new" post the owner writes once from the dashboard —
// shows on every server's Overview page (not scoped to one Guild), so every
// admin using the bot sees the same announcement.
model ChangelogEntry {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())
}

// Tracks the newest ChangelogEntry each dashboard user has seen, so the
// unread bell badge and the Overview card both know what's new to THEM —
// keyed by Discord user id, so it follows their account across devices.
model ChangelogSeen {
  id         String   @id @default(cuid())
  userId     String   @unique
  lastSeenAt DateTime @default(now())
}

model DashboardAuditEntry {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  userId    String
  username  String
  method    String
  path      String
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

// ---- Warn Escalation ----
// Auto-acts once a member racks up enough WARN cases within a rolling
// window — logCase() in apps/bot/src/lib/cases.ts is the one place every
// /warn (and dashboard-issued warning) already funnels through, so that's
// the trigger point rather than duplicating warn logic elsewhere.

model WarnEscalationSettings {
  id             String  @id @default(cuid())
  guild          Guild   @relation(fields: [guildId], references: [id])
  guildId        String  @unique
  warnThreshold  Int     @default(3)
  warnWindowDays Int     @default(30)
  action         String  @default("TIMEOUT") // TIMEOUT | KICK | BAN
  timeoutMinutes Int     @default(60)
  scaleDuration  Boolean @default(false) // when action is TIMEOUT, double timeoutMinutes for each prior auto-escalation instead of always using the same length
}

// ---- Ban/Mute Appeals ----
// A punished member gets DMed an "Appeal" prompt; their response becomes
// one of these, reviewed by staff in appealChannelId.

model AppealSettings {
  id              String  @id @default(cuid())
  guild           Guild   @relation(fields: [guildId], references: [id])
  guildId         String  @unique
  appealChannelId String?
}

model Appeal {
  id         String    @id @default(cuid())
  guild      Guild     @relation(fields: [guildId], references: [id])
  guildId    String
  userId     String
  caseId     String? // the ModerationCase being appealed, if one is linkable
  reason     String
  status     String    @default("PENDING") // PENDING | APPROVED | DENIED
  messageId  String? // the staff review message, for editing after a decision
  resolvedBy String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([guildId, status])
}

// ---- Mod Accountability Digest ----
// A periodic per-moderator tally of ModerationCase rows, posted to a
// staff channel — surfaces activity that otherwise only lives in the log.

model ModDigestSettings {
  id        String  @id @default(cuid())
  guild     Guild   @relation(fields: [guildId], references: [id])
  guildId   String  @unique
  channelId String?
}

// ---- Voice Activity ----
// Message-based XP/earning already exists (MemberXp, EconomyBalance) —
// this is the voice-channel equivalent. VoiceSession rows track an
// in-progress connection (closed out and folded into VoiceActivity's
// running total when the member leaves); VoiceActivity is the durable
// per-user total voice minutes, independent of leveling/economy so it can
// feed either without coupling them.

model VoiceSession {
  id       String   @id @default(cuid())
  guild    Guild    @relation(fields: [guildId], references: [id])
  guildId  String
  userId   String
  joinedAt DateTime @default(now())

  @@unique([guildId, userId])
}

model VoiceActivity {
  id           String @id @default(cuid())
  guild        Guild  @relation(fields: [guildId], references: [id])
  guildId      String
  userId       String
  totalMinutes Int    @default(0)

  @@unique([guildId, userId])
  @@index([guildId, totalMinutes])
}

// ---- Weekly Recap ----

model WeeklyRecapSettings {
  id        String  @id @default(cuid())
  guild     Guild   @relation(fields: [guildId], references: [id])
  guildId   String  @unique
  channelId String?
}

// ---- Achievements ----
// One row per member per milestone ever awarded — the unique constraint
// is what prevents re-awarding the same badge on a later trigger.

model Achievement {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  userId    String
  type      String // FIRST_MESSAGE | LEVEL_10 | LEVEL_25 | LEVEL_50 | STREAK_7 | STREAK_30 | VOICE_10H | VOICE_50H | CUSTOM:<CustomAchievement.id>
  channelId String? // where it was announced (the configured channel, or wherever it was earned) — null if nothing was sendable
  awardedAt DateTime @default(now())

  @@unique([guildId, userId, type])
  @@index([guildId, userId])
}

// Where achievement announcements post — without this, the bot posts in
// whatever channel the triggering action happened in.
model AchievementSettings {
  id        String  @id @default(cuid())
  guild     Guild   @relation(fields: [guildId], references: [id])
  guildId   String  @unique
  channelId String?
}

// Server-defined achievements on top of the built-in ones (First Message,
// Level 10/25/50, 7/30-day streak, 10h/50h in voice) — same triggers, but
// any threshold the admin wants, e.g. Level 5 or 100 hours in voice.
model CustomAchievement {
  id          String   @id @default(cuid())
  guild       Guild    @relation(fields: [guildId], references: [id])
  guildId     String
  name        String
  emoji       String   @default("🏆")
  triggerType String // LEVEL | VOICE_HOURS | DAILY_STREAK
  threshold   Int
  createdAt   DateTime @default(now())

  @@index([guildId, triggerType])
}

// ---- Support Intake (Support → Support Intake) ----
// A DM-based front door into the ticket system: a member DMs the bot,
// picks one of these flows, answers its question chain (one at a time),
// and a private ticket channel is created from the answers — same
// claim/close shape as the regular Tickets module, just triggered from a
// DM conversation instead of a panel button in a guild channel.

model SupportFlow {
  id          String   @id @default(cuid())
  guild       Guild    @relation(fields: [guildId], references: [id])
  guildId     String
  label       String // button text shown in the DM, e.g. "🐛 Bug Report"
  color       String? @default("#5865F2")
  categoryId  String? // Discord category the ticket channel is created under
  roleId      String? // support role pinged when a ticket opens
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  questions   SupportQuestion[]
  tickets     SupportTicket[]
  createdAt   DateTime @default(now())

  @@index([guildId])
}

enum SupportQuestionMode {
  TEXT
  CHOICE
}

model SupportQuestion {
  id        String              @id @default(cuid())
  flow      SupportFlow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowId    String
  prompt    String
  mode      SupportQuestionMode @default(TEXT)
  choices   Json                @default("[]") // string[] — only read when mode = CHOICE
  sortOrder Int                 @default(0)

  @@index([flowId])
}

enum SupportTicketStatus {
  DRAFT // mid-conversation in the DM, no channel yet
  OPEN
  CLAIMED
  CLOSED
}

model SupportTicket {
  id           String              @id @default(cuid())
  guild        Guild               @relation(fields: [guildId], references: [id])
  guildId      String
  flow         SupportFlow         @relation(fields: [flowId], references: [id])
  flowId       String
  userId       String // the member's Discord user id (the DM side)
  channelId    String? // set once the question chain finishes and the ticket channel is created
  questionIndex Int                @default(0) // which question in the flow they're currently answering
  answers      Json                @default("[]") // [{ prompt, answer }, ...] in question order
  transcript   Json                @default("[]") // [{ from: "member"|"staff"|"system", authorTag, content, at }, ...] appended live so it survives the channel being deleted on close
  status       SupportTicketStatus @default(DRAFT)
  claimedById  String?
  createdAt    DateTime            @default(now())
  closedAt     DateTime?

  @@index([guildId, status])
  @@index([userId, status])
}
